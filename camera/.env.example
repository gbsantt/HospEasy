# HOSPEASY_INTERVAL_SECONDS=180
# HOSPEASY_CONFIDENCE=0.5
# HOSPEASY_CAMERA_INDEX=0
# HOSPEASY_MODEL_PATH=/absolute/path/yolov8n.pt
