# Use HTTPS for an installed camera. Local HTTP is supported for development.
HOSPEASY_API_URL=http://localhost:8080
HOSPEASY_CAMERA_KEY=
# Optional defaults shared by the local test and production:
# HOSPEASY_INTERVAL_SECONDS=180
# HOSPEASY_CONFIDENCE=0.5
# HOSPEASY_CAMERA_INDEX=0
# HOSPEASY_CAMERA_WIDTH=1280
# HOSPEASY_CAMERA_HEIGHT=720
# HOSPEASY_SAMPLES=5
# HOSPEASY_SAMPLE_INTERVAL_SECONDS=0.5
# HOSPEASY_MODEL_PATH=yolov8n.onnx
